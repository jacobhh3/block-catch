<html lang="en-us"><script>
// The loading bar counts everything downloaded (about 22 MB of Python and the game) as it comes in.
// And in a local test built with build_web.py --mirror, anything still asked of pygame-web.github.io comes from the
// jsDelivr mirror of the same files instead (for networks that can't reach github.io).
var LOAD_BYTES = 22e6, load_got = 0  // read by the bar under the loading box
{
const mirror = "{{cookiecutter.cdn}}".includes("jsdelivr")
const fix = (u) => !mirror || typeof u !== "string" ? u : u
    .replace("https://pygame-web.github.io/cdn/", "https://cdn.jsdelivr.net/gh/pygame-web/cdn@main/")
    .replace("https://pygame-web.github.io/archives/", "https://cdn.jsdelivr.net/gh/pygame-web/archives@main/")
const realFetch = window.fetch
window.fetch = async (u, o) => {
    const r = await realFetch(mirror && u instanceof Request ? new Request(fix(u.url), u) : fix(u), o)
    try {  // count a copy of it, so the real one (like the .wasm) is left untouched
        const reader = r.clone().body.getReader()
        ;(async () => { for (;;) { const { done, value } = await reader.read(); if (done) break; load_got += value.length } })()
    } catch (e) {}
    return r
}
const realOpen = XMLHttpRequest.prototype.open
XMLHttpRequest.prototype.open = function (m, u, ...rest) {
    let seen = 0
    this.addEventListener("progress", (e) => { load_got += e.loaded - seen; seen = e.loaded })
    return realOpen.call(this, m, fix(u), ...rest)
}
}
