    <script type="application/javascript">

    // Fit the game to the screen at its own shape. pygbag's version measures only once, sometimes
    // before the game has set its size, which squashed it.
    // iPhones: the page reaches under the Dynamic Island (or notch) and the home bar, so measure those and keep
    // the game between them (otherwise the sound and pause buttons sit under the island, out of reach)
    const safe = document.createElement("div")
    safe.style.cssText = "position:fixed;visibility:hidden;pointer-events:none;" +
        "padding-top:env(safe-area-inset-top);padding-bottom:env(safe-area-inset-bottom)"
    document.documentElement.appendChild(safe)
    function fit_game() {
        const c = document.getElementById("canvas")
        if (c.width <= 1) return
        const inset = getComputedStyle(safe)
        const top = parseFloat(inset.paddingTop) || 0, bottom = parseFloat(inset.paddingBottom) || 0
        const scale = Math.min(window.innerWidth / c.width, (window.innerHeight - top - bottom) / c.height)
        c.style.width = Math.floor(c.width * scale) + "px"
        c.style.height = Math.floor(c.height * scale) + "px"
        c.style.top = top + "px"
        c.style.bottom = bottom + "px"
        c.style.margin = "auto"
    }
    setInterval(fit_game, 300)
    window.addEventListener("resize", fit_game)

    globalThis.__canvas_resized = (self, ecw, ech) => {
        console.warn("TODO: panda3d canvas monitor", self, ecw, ech)
