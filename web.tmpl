    <script>
    // Clawd drawn from the same 13x9 pixel art as the game
    ;(function () {
        const rows = ["..XXXXXXXXX..", "..XXXXXXXXX..", "..XXEXXXEXX..", "XXXXEXXXEXXXX", "XXXXXXXXXXXXX",
                      "..XXXXXXXXX..", "..XXXXXXXXX..", "..X.X...X.X..", "..X.X...X.X.."]
        let px = ""
        rows.forEach((row, y) => [...row].forEach((ch, x) => {
            if (ch != ".") px += `<rect x="${x}" y="${y}" width="1" height="1" fill="${ch == "E" ? "#1b1a24" : "#d97757"}"/>`
        }))
        loadclawd.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 13 9">${px}</svg>`
    })()

    // The loading bar: the downloads fill it to 80%; once they stop coming, it creeps on toward 95% while Python
    // starts up, and it's full when the game says TAP TO START.
    ;(function () {
        let shown = 0, last = 0, still = 0
        const tick = (t) => {
            if (loadbar.style.display == "none") return
            still = load_got == last ? still + 1 : 0
            last = load_got
            let target = Math.min(1, load_got / LOAD_BYTES) * 80
            if (infobox.innerText.startsWith("TAP")) target = 100
            else if (load_got > 1e6 && still > 60) target = Math.max(shown, 80) + (95 - Math.max(shown, 80)) * 0.01
            shown = Math.max(shown, Math.min(100, target))
            loadfill.style.width = shown + "%"
            requestAnimationFrame(tick)
        }
        requestAnimationFrame(tick)
    })()
    </script>

